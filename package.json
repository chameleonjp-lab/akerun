  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test:rules": "vitest run client/src/game",
    "generate:problem-balance": "node --import tsx/esm scripts/generate-official-problem-balance.ts",
    "format": "prettier --write .",
    "build:pages": "vite build && node scripts/verify-static-build.mjs dist/public",
